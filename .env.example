# ============================================================
# ACritica Lab — Variáveis de Ambiente
# Copie para .env.local e preencha com seus valores reais
# NUNCA commite o arquivo .env.local
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# URL pública do projeto (segura para frontend)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave anon (segura para frontend, respeita RLS)
VITE_SUPABASE_ANON_KEY=eyJh...

# Chave de serviço (APENAS backend/API routes — nunca expor no frontend!)
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# ── Twitter / X API v2 ───────────────────────────────────────
# Criar em: https://developer.twitter.com/en/portal/dashboard
# Permissões necessárias: Read and Write
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ── Facebook Graph API ───────────────────────────────────────
# Criar em: https://developers.facebook.com/apps/
# Permissões necessárias: pages_manage_posts, pages_read_engagement
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ── Segurança ────────────────────────────────────────────────
# Segredo para proteger o endpoint /api/cron de chamadas externas
# Gere um valor aleatório: openssl rand -hex 32
CRON_SECRET=

# ── Gemini (já existente) ────────────────────────────────────
GEMINI_API_KEY=
ALLOWED_ORIGIN=https://seu-app.vercel.app
